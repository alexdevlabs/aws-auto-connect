#!/bin/bash
# Root-owned tunnel helper, the only thing the sudoers rule allows.
#   vpn-helper connect <ipv4> <port> <udp|tcp> <auth-file>
#   vpn-helper disconnect
#   vpn-helper status
#   vpn-helper dns-config <file>   allowlist for dns-relay: `on|off`, then one domain per line
set -euo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022

DIR=/usr/local/libexec/aws-autoconnect
ETC=/usr/local/etc/aws-autoconnect
RUN=/var/run/aws-autoconnect
LOG=/var/log/aws-autoconnect.log
PIDFILE=$RUN/openvpn.pid

die() { echo "vpn-helper: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root"

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

stop() {
  if running; then
    local pid; pid=$(cat "$PIDFILE")
    kill "$pid"
    for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
    kill -9 "$pid" 2>/dev/null || true
  fi
  # A tunnel that was still starting may not have written its pidfile yet.
  pkill -f "^$DIR/openvpn --config $ETC/profile.ovpn " 2>/dev/null || true
  # openvpn's down hook didn't get to run (crash, kill -9): restore DNS here.
  [ -f "$RUN/dns-relay.conf" ] && "$DIR/dns.sh" down
  rm -f "$PIDFILE" "$RUN/auth"
}

case "${1:-}" in
  connect)
    [ $# -eq 5 ] || die "usage: connect <ipv4> <port> <proto> <auth-file>"
    ip=$2 port=$3 proto=$4 auth=$5
    [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "bad ip"
    [[ $port =~ ^[0-9]{1,5}$ ]] || die "bad port"
    [[ $proto == udp || $proto == tcp ]] || die "bad proto"
    [ -n "${SUDO_UID:-}" ] || die "run via sudo"
    [ -f "$ETC/profile.ovpn" ] || die "profile not installed"

    stop
    install -d -o root -g wheel -m 755 "$RUN"
    # Read the credentials with the caller's rights, never root's.
    ( umask 077; sudo -u "#$SUDO_UID" /bin/cat -- "$auth" | head -c 200000 > "$RUN/auth" )

    "$DIR/openvpn" --config "$ETC/profile.ovpn" \
      --remote "$ip" "$port" --proto "$proto" \
      --auth-user-pass "$RUN/auth" --auth-nocache --auth-retry none \
      --script-security 2 --up "$DIR/dns.sh up" --down "$DIR/dns.sh down" \
      --verb 3 --log "$LOG" --writepid "$PIDFILE" --daemon aws-autoconnect
    chmod 644 "$LOG" "$PIDFILE" 2>/dev/null || true
    ;;
  disconnect)
    stop
    ;;
  status)
    if running; then echo running; else echo stopped; fi
    ;;
  dns-config)
    [ $# -eq 2 ] || die "usage: dns-config <file>"
    [ -n "${SUDO_UID:-}" ] || die "run via sudo"
    install -d -o root -g wheel -m 755 "$RUN"
    tmp=$(mktemp "$RUN/dns-allowlist.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    sudo -u "#$SUDO_UID" /bin/cat -- "$2" | head -c 200000 > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$RUN/dns-allowlist"
    ;;
  *)
    die "usage: connect|disconnect|status|dns-config"
    ;;
esac
